# Sanity CMS — valeurs publiques (pas de secret)
NEXT_PUBLIC_SANITY_PROJECT_ID=fbdmm8o7
NEXT_PUBLIC_SANITY_DATASET=production

# Token API Sanity (optionnel pour lecture publique, requis pour preview de brouillons)
# Créer sur : https://www.sanity.io/manage/personal/project/fbdmm8o7/api?tokenName=luphy-website-prod&permissions=viewer
# SANITY_API_TOKEN=skXXXXXXXX

# Secret pour le webhook de revalidation Sanity
# Générer avec : openssl rand -hex 32   (ou n'importe quelle chaîne aléatoire)
# À renseigner aussi dans Vercel > Settings > Environment Variables
SANITY_REVALIDATE_SECRET=remplacer-par-une-vraie-valeur-aleatoire
